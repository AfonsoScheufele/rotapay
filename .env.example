# Postgres
POSTGRES_USER=rotapay
POSTGRES_PASSWORD=rotapay
POSTGRES_DB=rotapay
DATABASE_URL=postgresql+psycopg://rotapay:rotapay@localhost:5434/rotapay

# Redis (compose mapeia 6381→6379 para não conflitar com Redis local)
REDIS_URL=redis://localhost:6381/0

# JWT / Auth
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRE_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS / Front
FRONTEND_ORIGIN=http://localhost:5173

# Taxa da plataforma em basis points (500 = 5%)
PLATFORM_FEE_BPS=500

# SLA por distancia no aceite (Haversine)
# horas = clamp(MIN, MAX, (km / AVG_KMH) * BUFFER)
SLA_AVG_KMH=45
SLA_BUFFER=1.5
SLA_MIN_HOURS=72
SLA_MAX_HOURS=336

# Mercado Pago (sandbox / teste)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL publica da API para notification_url (ex.: https://api.seudominio.com)
API_PUBLIC_URL=http://localhost:8000

# Ambiente
ENVIRONMENT=development
